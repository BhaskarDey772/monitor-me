# ---------------------------------------------------------------------------
# Single shared env file for the whole monorepo.
# Copy to `.env` at the repo root:  cp .env.example .env
#
# The server loads this file with dotenv (apps/api/src/config/env.ts).
# The client loads it with Vite's `envDir` pointed at the repo root, so ONLY
# variables prefixed with VITE_ are exposed to the browser bundle. Never put a
# secret behind a VITE_ prefix — it ships to every visitor.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- server -----------------------------------------------------------------
PORT=4000

# Public origin of the API. Must match the origin the browser actually calls,
# otherwise Better Auth rejects the request as an untrusted origin.
SERVER_URL=http://localhost:4000

# Comma-separated allowlist of browser origins permitted by CORS and by Better
# Auth's trustedOrigins (CSRF defence). No wildcards.
#
# The FIRST entry is also the origin baked into subscribe QR codes, so it must be
# an address a phone can reach — `localhost` resolves to the phone itself. For
# device testing add your LAN IP first, e.g.
#   CLIENT_URL=http://192.168.1.20:5173,http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- database ---------------------------------------------------------------
# SQLite file path, relative to the REPO ROOT (resolved to an absolute path at
# runtime so the CLI and the server always open the same file).
DATABASE_URL="file:./apps/api/prisma/dev.db"

# --- alerts (ntfy) ----------------------------------------------------------
# ntfy instance alerts are published to. Self-hosted works: use its base URL and
# the deep link switches to `secure=false` automatically for plain http.
NTFY_SERVER=https://ntfy.sh

# --- auth -------------------------------------------------------------------
# Signing key for session cookies and tokens. Minimum 32 chars.
# Generate with:  npx auth@latest secret     (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-a-32-char-minimum-random-secret
BETTER_AUTH_URL=http://localhost:4000

# --- client (exposed to the browser) ---------------------------------------
# Leave empty to use same-origin requests through the Vite dev proxy / your
# reverse proxy. Set to the API origin only for a genuinely cross-origin deploy.
VITE_SERVER_URL=
